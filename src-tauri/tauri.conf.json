{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Llamrei",
  "version": "0.1.0",
  "identifier": "app.llamrei.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Llamrei — Personal Command Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self' https://s3.tradingview.com https://*.tradingview.com; connect-src 'self' http://127.0.0.1:4321 ws://127.0.0.1:5173 https://*.ts.net; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://s3.tradingview.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libsecret-1-0", "nodejs"]
      }
    }
  }
}
