{
  "name": "llamrei-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Dashboard Llamrei — ClickUp-style workspace, task alarms, Llamrei agent, scheduled chats, NectarLink Phone Hub, Tailscale-ready.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "test": "node --test \"server/tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
