<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050507"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_next_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏰ Next Alarm"
        android:textColor="#F59E0B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_task_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Task 1"
        android:textColor="#F2F2F2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_task_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Task 2"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_reminder_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🔔 Reminder"
        android:textColor="#00D992"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Snooze 10m"
            android:textSize="11sp" />
        <Button
            android:id="@+id/btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Dismiss"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
